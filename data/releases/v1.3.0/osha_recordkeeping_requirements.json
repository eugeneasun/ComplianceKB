    {
      "id": "OSHA-REC-011",
      "requirement_text": "The employer must record the recordable injuries and illnesses of employees on its payroll and workers it supervises day to day; sole proprietors and partners are not considered employees for Part 1904 recordkeeping purposes.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "incident_occurrence",
      "applicability": {
        "industries_naics": [],
        "business_activities": [
          "process_operation"
        ],
        "employee_size_band": "any",
        "jurisdictions": [
          "federal"
        ],
        "industry_scope": "all_covered_industries"
      },
      "provenance": {
        "source_document_id": "CFR-29-1904",
        "source_framework": "OSHA_RECORDKEEPING",
        "source_version": "2024-07-01",
        "source_clause": "§1904.31(a)",
        "source_text_excerpt": "You must record on the OSHA 300 Log the recordable injuries and illnesses of all employees on your payroll, whether they are labor, executive, hourly, salary, part-time, seasonal, or migrant workers. You also must record the recordable injuries and illnesses that occur to employees who are not on your payroll if you supervise these employees on a day-to-day basis. If your business is organized as a sole proprietorship or partnership, the owner or partners are not considered employees for recordkeeping purposes.",
        "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.31(a)",
        "source_retrieved_at": "2026-09-26T00:00:00Z",
        "source_text_hash": "11229654350ee3aec908c542d35865f46cf8cec107386c38aa855370bce2fea7",
