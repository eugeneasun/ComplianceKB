        "curator": "Eugene Sun",
        "review_date": "2026-09-23"
      },
      "verification_status": "implemented_from_human_verification"
    },
    {
      "id": "OSHA-REC-012",
      "requirement_text": "During the five-year storage period, the employer must update stored OSHA 300 Logs for newly discovered recordable cases and classification changes; when a description or outcome changes, the original entry must be removed or lined out and replaced with the new information.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "low",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "always_on",
      "applicability": {
        "industries_naics": [],
        "business_activities": [
          "process_operation"
        ],
        "employee_size_band": "any",
        "jurisdictions": [
          "federal"
