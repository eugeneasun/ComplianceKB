    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-021",
      "requirement_text": "The employer shall perform a pre-startup safety review for new facilities and for modified facilities when the modification is significant enough to require a change in the process safety information.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(i)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(i)(1)",
      "source_text_excerpt": "The employer shall perform a pre-startup safety review for new facilities and for modified facilities when the modification is significant enough to require a change in the process safety information.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "4e21e7e9b27095f0584fe05b7a0751ec3f70939d528db00cb79c099c0e4f35d0",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-022",
      "requirement_text": "Before introducing highly hazardous chemicals, the pre-startup safety review shall confirm that construction and equipment meet design specifications; procedures are adequate; for new facilities a process hazard analysis has been performed and recommendations resolved or implemented, or for modified facilities management-of-change requirements have been met; and employee training is complete.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "inspection_record",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation",
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(i)(2)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(i)(2)",
      "source_text_excerpt": "The pre-startup safety review shall confirm that prior to the introduction of highly hazardous chemicals to a process:\n(i) construction and equipment is in accordance with design specifications;\n(ii) safety, operating, maintenance, and emergency procedures are in place and are adequate;\n(iii) for new facilities, a process hazard analysis has been performed and recommendations have been resolved or implemented before startup; for modified facilities, the requirement in §1910.119(l) (management of change) has been met;\n(iv) training of each employee involved in operating the process has been completed.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "55c30a2f8354b9562a497bd00c5aa36d5020823bb06f533d62679217a2957a82",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
