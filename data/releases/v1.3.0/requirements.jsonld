    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-021",
      "requirement_text": "For privacy concern cases, the employer must maintain a separate confidential list of case numbers and employee names so cases can be updated and information supplied to the government on request.",
