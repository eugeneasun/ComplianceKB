      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-001",
      "requirement_text": "Each employer required to keep records must record each fatality, injury, and illness that is work-related, is a new case, and meets one or more of the general recording criteria.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.4(a)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.4(a)",
      "source_text_excerpt": "Each employer required by this part to keep records of fatalities, injuries, and illnesses must record each fatality, injury and illness that is work-related; is a new case; and meets one or more of the general recording criteria.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "e90b093f5bdfac90f6722a868c68bf75ce491be1c3fd3455f73efc60a60658cc",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-002",
      "requirement_text": "The employer must consider an injury or illness to meet the general recording criteria if it results in death, days away from work, restricted work, transfer to another job, medical treatment beyond first aid, loss of consciousness, or diagnosis of a significant injury by a health care professional.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.7(a)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.7(a)",
      "source_text_excerpt": "You must consider an injury or illness to meet the general recording criteria, and therefore to be recordable, if it results in any of the following: death, days away from work, restricted work or transfer to another job, medical treatment beyond first aid, or loss of consciousness.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "b33bff6f08d328571c45bbccbd758b9a2f11490c75ed05c6a7e8cbb40540ae2e",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-003",
      "requirement_text": "The employer must enter each recordable injury or illness on the OSHA 300 Log and 301 Incident Report within seven calendar days of receiving information that a recordable injury or illness has occurred.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.29(b)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.29(b)(3)",
      "source_text_excerpt": "You must enter each recordable injury or illness on the OSHA 300 Log and 301 Incident Report within seven (7) calendar days of receiving information that a recordable injury or illness has occurred.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "5bbc409d9bd0ac324b7a4ffacde89ad311a4d80312ea43edd18fdadc9f03662f",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-004",
      "requirement_text": "At the end of each calendar year, the employer must review the OSHA 300 Log for completeness and accuracy and correct identified deficiencies.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "document_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "annual_review",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.32(a)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.32(a)(1)",
      "source_text_excerpt": "(1) Review the OSHA 300 Log to verify that the entries are complete and accurate, and correct any deficiencies identified;",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "ec72b3a8d0a071ac3a251b79afd13008833ef1b73962135dd3b708fad7acf191",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-005",
      "requirement_text": "The employer must post the annual summary in a conspicuous place where notices to employees are customarily posted, and ensure it is not altered, defaced, or covered by other material.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "low",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "annual_review",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.32(b)(5)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.32(b)(5)",
      "source_text_excerpt": "You must post a copy of the annual summary in each establishment in a conspicuous place or places where notices to employees are customarily posted. You must ensure that the posted annual summary is not altered, defaced or covered by other material.\n\n[CURRENT OSHA, accessed 2026-09-26, §1904.32(b)(6), for contrast]\nYou must post the summary no later than February 1 of the year following the year covered by the records and keep the posting in place until April 30.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "9122566d610f77d49d22e3c52fc01d9af044ebe5d3663f89829169e5b9bff1e7",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-006",
      "requirement_text": "Within eight hours after the death of any employee from a work-related incident, the employer must report the fatality to OSHA.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "record_review",
      "audit_evidence_type": "manifest_or_form",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.39(a)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.39(a)(1)",
      "source_text_excerpt": "Within eight (8) hours after the death of any employee as a result of a work-related incident, you must report the fatality to OSHA.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "3b05f2d8bdea1308e829827c77f2e529209874afb1bfeb8529ae4902276142f0",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-007",
      "requirement_text": "Within twenty-four hours after an employee's work-related in-patient hospitalization, amputation, or loss of an eye, the employer must report the event to OSHA.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "manifest_or_form",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.39(a)(2)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.39(a)(2)",
      "source_text_excerpt": "Within twenty-four (24) hours after the in-patient hospitalization of one or more employees or an employee's amputation or an employee's loss of an eye, as a result of a work-related incident, you must report the event to OSHA.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "5a8ccad507b476e556012db1f8d4b7d4abe4c8bd8d92e98c6e635d225be26745",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-008",
      "requirement_text": "The employer must retain the OSHA 300 Log, the privacy case list, the annual summary, and the 301 Incident Report forms for five years following the end of the calendar year that the records cover.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "low",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.33(a)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.33(a)",
      "source_text_excerpt": "You must save the OSHA 300 Log, the privacy case list (if one exists), the annual summary, and the OSHA 301 Incident Report forms for five (5) years following the end of the calendar year that these records cover.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "0ca205ec63d8d5acbdb4eab45a85b64c1ce0853b826baa104095601e338bf6ce",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-009",
      "requirement_text": "If a case is a privacy concern case, the employer may not enter the employee's name on the OSHA 300 Log and shall instead enter 'privacy case' in the space normally used for the name.",
      "is_mandatory": true,
      "requirement_type": "prohibition",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.29(b)(6)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.29(b)(6)",
      "source_text_excerpt": "If you have a \"privacy concern case,\" you may not enter the employee's name on the OSHA 300 Log. Instead, enter \"privacy case\" in the space normally used for the employee's name.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "ef49bf095e92bbb41bdd641ec9bd9f5160e8d3b620c8d651288c9dd46af28e58",
