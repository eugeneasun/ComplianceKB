      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(f)(3)",
      "source_text_excerpt": "The employer shall certify annually that these operating procedures are current and accurate.",
      "source_version": "2024-07-01",
