  "@graph": [
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-001",
      "requirement_text": "The employer shall develop, implement, and maintain at each workplace a written hazard communication program describing how labels, safety data sheets, and employee training requirements will be met, including a list of hazardous chemicals present.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(e)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(e)(1)",
      "source_text_excerpt": "Employers shall develop, implement, and maintain at each workplace, a written hazard communication program which at least describes how the criteria specified in paragraphs (f), (g), and (h) of this section for labels and other forms of warning, safety data sheets, and employee information and training will be met.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "1cf8e95ee0d69e828ada2ea0697fd2852cdcf180f29853be5a74e950725ddaf4",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-002",
      "requirement_text": "The written hazard communication program shall include a list of the hazardous chemicals known to be present using a product identifier referenced on the appropriate safety data sheet.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "chemical_procurement",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling",
        "material_storage"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(e)(1)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(e)(1)(i)",
      "source_text_excerpt": "A list of the hazardous chemicals known to be present using a product identifier that is referenced on the appropriate safety data sheet (the list may be compiled for the workplace as a whole or for individual work areas).",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "f97a33e68b4e035fb58d88b33c7fb8a1eaae24171596681f808417b28f6c1b03",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-003",
      "requirement_text": "The chemical manufacturer, importer, or distributor shall ensure that each container of hazardous chemicals leaving the workplace is labeled with the product identifier, signal word, hazard statement, pictogram, precautionary statement, and supplier information.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "chemical_procurement",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling",
        "material_storage"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(f)(1)",
      "supporting_clauses": [
        "§1910.1200(f)(1)(i)",
        "§1910.1200(f)(1)(ii)",
        "§1910.1200(f)(1)(iii)",
        "§1910.1200(f)(1)(iv)",
        "§1910.1200(f)(1)(v)",
        "§1910.1200(f)(1)(vi)"
      ],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(f)(1)",
      "source_text_excerpt": "The chemical manufacturer, importer, or distributor shall ensure that each container of hazardous chemicals leaving the workplace is labeled, tagged, or marked.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "3401046d0a18e395c4555e7a39f60fb2956281fd50acf1e53b15cc4d2ab2e8bb",
