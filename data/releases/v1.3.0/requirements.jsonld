    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-004",
      "requirement_text": "Except as provided for alternative written materials under §1910.1200(f)(7) and portable containers for immediate use under §1910.1200(f)(8), the employer shall ensure that each workplace container of hazardous chemicals is labeled with either the information required for shipped-container labels or a product identifier and words, pictures, symbols, or a combination providing general hazard information.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling",
        "material_storage"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(f)(6)",
      "supporting_clauses": [
        "§1910.1200(f)(6)(i)",
        "§1910.1200(f)(6)(ii)",
        "§1910.1200(f)(7)",
        "§1910.1200(f)(8)"
      ],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(f)(6)",
      "source_text_excerpt": "the employer shall ensure that each container of hazardous chemicals in the workplace is labeled, tagged, or marked.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "641db551088c108652c447277596cf23889b92fdc56e444f76c316f0d64787dd",
