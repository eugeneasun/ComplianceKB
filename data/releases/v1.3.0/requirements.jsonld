    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-047",
      "requirement_text": "The employer shall review operating procedures as often as necessary and update them to reflect current operating practice and relevant changes to process chemicals, technology, equipment, and facilities.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "document_review",
      "audit_evidence_type": "procedure",
      "workflow_trigger": "facility_change",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation",
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(f)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(f)(3)",
      "source_text_excerpt": "(3) The operating procedures shall be reviewed as often as necessary to assure that they reflect current operating practice, including changes that result from changes in process chemicals, technology, and equipment, and changes to facilities.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "106b9bfa3e836875d2de1dad12739218ff5f30e7e247c184b23973e99d325a65",
