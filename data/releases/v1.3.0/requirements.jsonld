      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-005",
      "requirement_text": "The employer shall have a safety data sheet in the workplace for each hazardous chemical which they use.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "safety_data_sheet",
      "workflow_trigger": "chemical_procurement",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(g)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(g)(1)",
      "source_text_excerpt": "Employers shall have a safety data sheet in the workplace for each hazardous chemical which they use.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "db89d7dda471607e9c2b5d924a560dfe52c0de3d82e0b591acee3dbbc42282f9",
