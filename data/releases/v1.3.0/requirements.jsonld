      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-012",
      "requirement_text": "The employer shall certify that the periodic inspection of the energy control procedure has been performed. The certification shall identify the machine or equipment on which the energy control procedure was being utilized, the date of the inspection, the employees included in the inspection, and the person performing the inspection.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "certification",
      "workflow_trigger": "annual_review",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(6)(ii)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(6)(ii)",
      "source_text_excerpt": "The employer shall certify that the periodic inspections have been performed. The certification shall identify the machine or equipment on which the energy control procedure was being utilized, the date of the inspection, the employees included in the inspection, and the person performing the inspection.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "eb285f5b1a8a3c8eac47739b0cb27c504401e245f455279a379f5d9179aad79a",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-27",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-013",
      "requirement_text": "The employer shall certify that employee training on the energy control program has been accomplished and is being kept up to date. The certification shall contain each employee's name and the dates of training.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "certification",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(7)(iv)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(7)(iv)",
      "source_text_excerpt": "The employer shall certify that employee training has been accomplished and is being kept up to date. The certification shall contain each employee's name and dates of training.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "ba83422e6b7cea89833d3f42f908ab7544bc8da7c4f52340091bada92af71d3c",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-27",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-001",
      "requirement_text": "The employer shall develop a written plan of action regarding the implementation of employee participation.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(c)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(c)(1)",
      "source_text_excerpt": "Employers shall develop a written plan of action regarding the implementation of the employee participation required by this paragraph.",
      "source_version": "2024-07-01",
