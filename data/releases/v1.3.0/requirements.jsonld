      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-035",
      "requirement_text": "The employer shall certify that they have evaluated compliance with the provisions of this section at least every three years to verify that procedures and practices are adequate and are being followed.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "certification",
      "workflow_trigger": "audit_preparation",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(o)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(o)(1)",
      "source_text_excerpt": "Employers shall certify that they have evaluated compliance with the provisions of this section at least every three years to verify that the procedures and practices developed under the standard are adequate and are being followed.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
