    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-041",
      "requirement_text": "In the construction of new plants and equipment, the employer shall assure that equipment as it is fabricated is suitable for the process application for which it will be used.",
      "is_mandatory": true,
