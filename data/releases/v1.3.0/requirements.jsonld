      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-039",
      "requirement_text": "The employer shall use one or more recognized methodologies (such as What-If, Checklist, HAZOP, FMEA, or Fault Tree Analysis) appropriate to determine and evaluate the hazards of the process being analyzed.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(e)(2)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(e)(2)",
      "source_text_excerpt": "The employer shall use one or more of the following methodologies that are appropriate to determine and evaluate the hazards of the process being analyzed. What-If; Checklist; What-If/Checklist; Hazard and Operability Study (HAZOP); Failure Mode and Effects Analysis (FMEA); Fault Tree Analysis; or An appropriate equivalent methodology.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "16269f40f589bf5724c6ea41c5cfec4120d5558e67c33b20e7ea36115fc23d42",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-26",
      "verification_status": "implemented_from_human_verification"
    },
    {
