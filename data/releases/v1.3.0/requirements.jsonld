    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-011",
      "requirement_text": "Whenever outside servicing personnel are engaged in covered activities, the on-site employer and the outside employer shall inform each other of their respective lockout or tagout procedures.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "interview",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(f)(2)(i)",
      "supporting_clauses": [],
