      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-014",
      "requirement_text": "Operating procedures shall be readily accessible to employees who work in or maintain a process.",
      "is_mandatory": true,
