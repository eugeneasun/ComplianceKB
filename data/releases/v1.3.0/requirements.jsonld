      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-055",
      "requirement_text": "The contract employer shall advise the host employer of unique hazards presented by the contract work and hazards discovered during that work.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "interview",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(h)(3)(v)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(h)(3)(v)",
      "source_text_excerpt": "(v) The contract employer shall advise the employer of any unique hazards presented by the contract employer's work, or of any hazards found by the contract employer's work.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "fc56e75bd3c9c285c067ac15c4de5b9e7ec925d3b5d118852b9579b8c2720992",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-27",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-056",
      "requirement_text": "At the conclusion of an incident investigation, the employer shall prepare a report that includes, at a minimum, the date of the incident, the date the investigation began, a description of the incident, the factors that contributed to the incident, and any recommendations resulting from the investigation.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(m)(4)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(m)(4)",
      "source_text_excerpt": "A report shall be prepared at the conclusion of the investigation which includes at a minimum: (i) Date of incident; (ii) Date investigation began; (iii) A description of the incident; (iv) The factors that contributed to the incident; and, (v) Any recommendations resulting from the investigation.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "cb973b0726a9e0ab44889487ec922dace241e1bf7503f72f0cdf6863fd2379fa",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-27",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-057",
      "requirement_text": "The employer shall develop a report of the findings of the compliance audit conducted under this section.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "certification",
      "workflow_trigger": "audit_preparation",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(o)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(o)(3)",
      "source_text_excerpt": "A report of the findings of the audit shall be developed.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "4c1062f09510bda2ae2292d5b33088ce4e7dae53f27f815486513f1941271d67",
      "curation_method": "ai_assisted_with_human_review",
