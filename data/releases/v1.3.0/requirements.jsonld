    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-023",
      "requirement_text": "When an employee, former employee, or personal representative requests the OSHA 301 Incident Report describing that employee's injury or illness, the employer must provide the report by the end of the next business day.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
