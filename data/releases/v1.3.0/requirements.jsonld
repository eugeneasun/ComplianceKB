    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-026",
      "requirement_text": "An establishment with 20 to 249 employees in an industry listed in Appendix A to Subpart E must electronically submit OSHA Form 300A information annually by the specified reporting date.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "manifest_or_form",
      "workflow_trigger": "annual_review",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [],
      "industry_condition": "Industry listed in Appendix A to Subpart E of 29 CFR Part 1904.",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "20-249",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.41(a)(1)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.41(a)(1)(i)",
      "source_text_excerpt": "(i) If your establishment had 20-249 employees at any time during the previous calendar year, and your establishment is classified in an industry listed in appendix A to subpart E of this part, then you must electronically submit information from OSHA Form 300A Summary of Work-Related Injuries and Illnesses to OSHA or OSHA's designee. You must submit the information once a year, no later than the date listed in paragraph (c) of this section of the year after the calendar year covered by the form.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "c8e12cf10347142f7b91033ed5f3791a60009dd6283d91266937d2c084d307ae",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-27",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-027",
      "requirement_text": "The employer must not discharge or in any manner discriminate against an employee for reporting a work-related fatality, injury, or illness; for filing a safety and health complaint; for requesting access to Part 1904 injury and illness records; or for otherwise exercising any right afforded by the OSH Act.",
      "is_mandatory": true,
      "requirement_type": "prohibition",
      "risk_level": "high",
      "verification_method": "interview",
      "audit_evidence_type": "complaint_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.36",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.36",
      "source_text_excerpt": "In addition to Sec.1904.35, section 11(c) of the OSH Act also prohibits you from discriminating against an employee for reporting a work-related fatality, injury, or illness. That provision of the Act also protects the employee who files a safety and health complaint, asks for access to the part 1904 records, or otherwise exercises any rights afforded by the OSH Act.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "62ad83c0ddc68797bb61a0cfdd6fc50d34eaea233b7de77063297ef916c2c0e5",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-27",
      "verification_status": "implemented_from_human_verification"
    }
  ]
