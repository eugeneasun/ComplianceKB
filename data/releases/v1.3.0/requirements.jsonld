    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-014",
      "requirement_text": "The employer shall not remove or deface existing labels on incoming containers of hazardous chemicals unless the container is immediately marked with the required information.",
      "is_mandatory": true,
      "requirement_type": "prohibition",
      "risk_level": "high",
      "verification_method": "physical_inspection",
