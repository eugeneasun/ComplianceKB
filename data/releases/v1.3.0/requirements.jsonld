        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(h)(3)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(h)(3)(i)",
      "source_text_excerpt": "The contract employer shall assure that each contract employee is trained in the work practices necessary to safely perform his/her job.",
