    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-025",
      "requirement_text": "The employer shall inspect and test process equipment using recognized and generally accepted good engineering practices, at frequencies consistent with manufacturer recommendations and good engineering practices, and shall document each inspection and test performed.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "inspection_record",
      "workflow_trigger": "scheduled_inspection",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(j)(4)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(j)(4)",
      "source_text_excerpt": "Inspections and tests shall be performed on process equipment. Inspection and testing procedures shall follow recognized and generally accepted good engineering practices. The frequency of inspections and tests of process equipment shall be consistent with applicable manufacturers' recommendations and good engineering practices, and more frequently if determined to be necessary by prior operating experience. The employer shall document each inspection and test that has been performed on process equipment.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "7e346cdbfff19129ec2e37b6f37577c6778ea4e7c18a3074f1b46443171f0783",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-026",
      "requirement_text": "The employer shall correct deficiencies in equipment that are outside acceptable limits before further use or in a safe and timely manner when necessary means are taken to assure safe operation.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "inspection_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(j)(5)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(j)(5)",
      "source_text_excerpt": "The employer shall correct deficiencies in equipment that are outside acceptable limits (defined by the process safety information in paragraph (d) of this section) before further use or in a safe and timely manner when necessary means are taken to assure safe operation.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "c059a816fd7ddd64592582c0c4961c04dcd41239ff1f398a9f1ce1add67c0b34",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-027",
      "requirement_text": "The employer shall issue a hot work permit for hot work operations conducted on or near a covered process.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "document_review",
      "audit_evidence_type": "permit",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31,
        23
      ],
      "industry_condition": "",
      "business_activities": [
        "hot_work",
        "welding_cutting"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(k)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(k)(1)",
      "source_text_excerpt": "The employer shall issue a hot work permit for hot work operations conducted on or near a covered process.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "4ebc9361f2b480f8a9e4e2291b038f02f372d61c4c3f18f71a3180644a3961ea",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-028",
      "requirement_text": "The hot work permit shall document compliance with fire prevention and protection requirements, indicate the authorized dates, and identify the object on which hot work is performed; it shall be kept on file until completion of the operation.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "permit",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31,
        23
      ],
      "industry_condition": "",
      "business_activities": [
        "hot_work",
        "welding_cutting"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(k)(2)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(k)(2)",
      "source_text_excerpt": "The permit shall document that the fire prevention and protection requirements in 29 CFR 1910.252(a) have been implemented prior to beginning the hot work operations; it shall indicate the date(s) authorized for hot work; and identify the object on which hot work is to be performed.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "37df772ddf8b6bfa9f53c20a30ebca3f66030365bc6207038d003adffc300884",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-029",
      "requirement_text": "The employer shall establish and implement written procedures to manage changes to process chemicals, technology, equipment, procedures, and facilities affecting a covered process, except for replacements in kind.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "procedure",
      "workflow_trigger": "facility_change",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation",
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(l)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(l)(1)",
      "source_text_excerpt": "The employer shall establish and implement written procedures to manage changes (except for \"replacements in kind\") to process chemicals, technology, equipment, and procedures; and, changes to facilities that affect a covered process.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "5d2c0c5af01369e50e57b1d119de51a71748399a6b6fbcdd55914f6d304dd36a",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-030",
      "requirement_text": "Employees involved in operating a process and maintenance and contract employees whose job tasks will be affected by a change shall be informed of and trained in the change prior to start-up.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "facility_change",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(l)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(l)(3)",
      "source_text_excerpt": "Employees involved in operating a process and maintenance and contract employees whose job tasks will be affected by a change in the process shall be informed of, and trained in, the change prior to start-up of the process or affected part of the process.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "71acb573fe23f13b2c8faf8fdf62afb3e9d562ec1e1f746af69b073b5ca4b180",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-25",
      "verification_status": "implemented_from_human_verification"
    },
    {
