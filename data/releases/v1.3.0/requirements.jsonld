      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-006",
      "requirement_text": "The employer shall maintain safety data sheets and ensure they are readily accessible during each work shift to employees when they are in their work areas.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(g)(8)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(g)(8)",
      "source_text_excerpt": "The employer shall maintain in the workplace copies of the required safety data sheets for each hazardous chemical, and shall ensure that they are readily accessible during each work shift to employees when they are in their work area(s). (Electronic access and other alternatives to maintaining paper copies of the safety data sheets are permitted as long as no barriers to immediate employee access in each workplace are created by such options.)",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "722a82de382c6c8b10691c6068dcc3a5231afacc25f5e89f9b5ae17d138b01b4",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-007",
      "requirement_text": "The employer shall provide employees with effective information and training on hazardous chemicals in their work area at initial assignment and whenever a new chemical hazard about which the employees have not previously been trained is introduced into their work area.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "onboarding_new_employee",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(h)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(h)(1)",
      "source_text_excerpt": "Employers shall provide employees with effective information and training on hazardous chemicals in their work area at the time of their initial assignment, and whenever a new chemical hazard the employees have not previously been trained about is introduced into their work area.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "fd7d0bd20664d417cb87072f7aa9a560043f9fbf5e2aa8a810b2a127b962af87",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-008",
      "requirement_text": "Employees shall be informed of the requirements of the hazard communication standard, operations where hazardous chemicals are present, and the location and availability of the written hazard communication program, including the required hazardous-chemical lists and safety data sheets.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "interview",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "onboarding_new_employee",
      "workflow_trigger_details": {
        "additional_triggers": [
          "chemical_procurement"
        ],
        "condition": "A new chemical hazard is introduced into the work area."
      },
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(h)(2)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(h)(2)",
      "source_text_excerpt": "Employees shall be informed of: The requirements of this section; Any operations in their work area where hazardous chemicals are present; and, The location and availability of the written hazard communication program.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "4b15da4e8fe9a67b4b3c310d2ea7768dcbb5176246620918a758e4675386f1bd",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-009",
      "requirement_text": "Chemical manufacturers and importers shall evaluate chemicals produced in their workplaces or imported by them to classify the chemicals in accordance with this section.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "chemical_procurement",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(d)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(d)(1)",
      "source_text_excerpt": "Chemical manufacturers and importers shall evaluate chemicals produced in their workplaces or imported by them to classify the chemicals in accordance with this section. For each chemical, the chemical manufacturer or importer shall determine the hazard classes, and where appropriate, the category of each class that apply to the chemical being classified.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "5eb2834d570eb87c81106782591a87aebc9104c76c1a8ff7d39a9aa60446a4e7",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-010",
      "requirement_text": "Employers at multi-employer workplaces shall include in their hazard communication program the methods for providing other employers with on-site access to safety data sheets and informing them of precautionary measures and the labeling system used.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(e)(2)",
      "supporting_clauses": [
        "§1910.1200(e)(2)(i)",
        "§1910.1200(e)(2)(ii)",
        "§1910.1200(e)(2)(iii)"
      ],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(e)(2)",
      "source_text_excerpt": "Employers who produce, use, or store hazardous chemicals at a workplace in such a way that the employees of other employer(s) may be exposed shall additionally ensure that the hazard communication programs developed and implemented under this paragraph (e) include the methods the employer will use to provide the other employer(s) on-site access to safety data sheets for each hazardous chemical.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "05bc20e7b993d8edaa9d73773af4f3c67655cf5bb92008343b0ba3b370ec8c22",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-011",
      "requirement_text": "The employer shall make the written hazard communication program available, upon request, to employees, their designated representatives, and OSHA officials.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "low",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(e)(4)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(e)(4)",
      "source_text_excerpt": "The employer shall make the written hazard communication program available, upon request, to employees, their designated representatives, the Assistant Secretary and the Director, in accordance with the requirements of 29 CFR 1910.1020(e).",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "c49da858bb15f082646fbe4f7e8e9281a81251243fd2f2eea50bb143bc882b5f",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-012",
      "requirement_text": "The employer may use signs, placards, process sheets, batch tickets, or other written materials in lieu of affixing labels to individual stationary process containers, provided the alternative method identifies the containers and conveys the required label information.",
      "is_mandatory": false,
      "requirement_type": "permission",
      "risk_level": "low",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "procedure",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling",
        "material_storage"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(f)(7)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(f)(7)",
      "source_text_excerpt": "The employer may use signs, placards, process sheets, batch tickets, operating procedures, or other such written materials in lieu of affixing labels to individual stationary process containers, as long as the alternative method identifies the containers to which it is applicable and conveys the information required by paragraph (f)(6) of this section.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "e78982d2e81cf8c6f6cf023c72a1c3519b20c82f560026d0fad066b27db4a488",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-013",
      "requirement_text": "The employer is not required to label portable containers into which hazardous chemicals are transferred from labeled containers and which are intended only for the immediate use of the employee who performs the transfer.",
      "is_mandatory": false,
      "requirement_type": "permission",
      "risk_level": "low",
      "verification_method": "observation",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(f)(8)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(f)(8)",
      "source_text_excerpt": "The employer is not required to label portable containers into which hazardous chemicals are transferred from labeled containers, and which are intended only for the immediate use of the employee who performs the transfer.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "acf8515622a31099c2f69ceae6a421fa5ecf4e321f11e11df9901de37f3d127a",
