    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-011",
      "requirement_text": "The employer must record the recordable injuries and illnesses of employees on its payroll and workers it supervises day to day; sole proprietors and partners are not considered employees for Part 1904 recordkeeping purposes.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "incident_occurrence",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.31(a)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.31(a)",
      "source_text_excerpt": "You must record on the OSHA 300 Log the recordable injuries and illnesses of all employees on your payroll, whether they are labor, executive, hourly, salary, part-time, seasonal, or migrant workers. You also must record the recordable injuries and illnesses that occur to employees who are not on your payroll if you supervise these employees on a day-to-day basis. If your business is organized as a sole proprietorship or partnership, the owner or partners are not considered employees for recordkeeping purposes.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "11229654350ee3aec908c542d35865f46cf8cec107386c38aa855370bce2fea7",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-012",
      "requirement_text": "During the five-year storage period, the employer must update stored OSHA 300 Logs for newly discovered recordable cases and classification changes; when a description or outcome changes, the original entry must be removed or lined out and replaced with the new information.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "low",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.33(b)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.33(b)(1)",
      "source_text_excerpt": "Yes, during the storage period, you must update your stored OSHA 300 Logs to include newly discovered recordable injuries or illnesses and to show any changes that have occurred in the classification of previously recorded injuries and illnesses. If the description or outcome of a case changes, you must remove or line out the original entry and enter the new information.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "ce587421d96ff6a57aa85070c90c6265d9fbdb9d297ebc019991f8e00030f3d0",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-013",
      "requirement_text": "The employer must establish a reasonable procedure for employees to report work-related injuries and illnesses promptly and accurately; the procedure must not deter or discourage accurate reporting.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "interview",
      "audit_evidence_type": "procedure",
      "workflow_trigger": "onboarding_new_employee",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.35(b)(1)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.35(b)(1)(i)",
      "source_text_excerpt": "(i) You must establish a reasonable procedure for employees to report work-related injuries and illnesses promptly and accurately. A procedure is not reasonable if it would deter or discourage a reasonable employee from accurately reporting a workplace injury or illness;",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "088e4d769fe227c2fc68b75875c6710f64e188669417e0f8bbb71915af5475a4",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-014",
      "requirement_text": "The employer must not discharge or in any manner discriminate against any employee for reporting a work-related injury or illness.",
      "is_mandatory": true,
      "requirement_type": "prohibition",
      "risk_level": "critical",
      "verification_method": "interview",
      "audit_evidence_type": "complaint_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.35(b)(1)(iv)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.35(b)(1)(iv)",
      "source_text_excerpt": "You must not discharge or in any manner discriminate against any employee for reporting a work-related injury or illness.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "2fa85a9036ce7d995e288350e3d6207adcee29fd2cde6638cf4c070d3da86809",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-015",
      "requirement_text": "When an employee, former employee, personal representative, or authorized employee representative requests relevant OSHA 300 Logs for an establishment where the employee worked, the employer must provide copies by the end of the next business day.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.35(b)(2)(iii)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.35(b)(2)(iii)",
      "source_text_excerpt": "(iii) If an employee or representative asks for access to the OSHA 300 Log, when do I have to provide it? When an employee, former employee, personal representative, or authorized employee representative asks for copies of your current or stored OSHA 300 Log(s) for an establishment the employee or former employee has worked in, you must give the requester a copy of the relevant OSHA 300 Log(s) by the end of the next business day.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "0f65e1edc1dc59b3ac5db390bb2d326cf8aa6f5ee8a22c6b1a53f87962daa739",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-016",
      "requirement_text": "When an authorized government representative asks for the records kept under Part 1904, the employer must provide copies within four business hours.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "audit_preparation",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.40(a)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.40(a)",
      "source_text_excerpt": "When an authorized government representative asks for the records you keep under part 1904, you must provide copies of the records within four (4) business hours.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "93c406a6849e0e0420c3d64dd119a1b2530871e8914325dac77f0306677310ae",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-017",
      "requirement_text": "Establishments with 250 or more employees that are required to keep Part 1904 records must electronically submit information from the OSHA Form 300A annually.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "manifest_or_form",
      "workflow_trigger": "annual_review",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "250+",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.41(a)(1)(ii)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.41(a)(1)(ii)",
      "source_text_excerpt": "If your establishment had 250 or more employees at any time during the previous calendar year, and this part requires your establishment to keep records, then you must electronically submit information from OSHA Form 300A Summary of Work-Related Injuries and Illnesses to OSHA or OSHA's designee.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "46d094f88ef13d3a7d8bdc9ad1223890d509e2708201c0fa3003224fb82d40b5",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-23",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-018",
      "requirement_text": "At the end of each calendar year, the employer must create an annual summary of injuries and illnesses recorded on the OSHA 300 Log.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "document_review",
