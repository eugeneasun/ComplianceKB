    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-015",
      "requirement_text": "The chemical manufacturer, importer, or employer preparing the safety data sheet shall ensure that significant new hazard or protective-measure information is added to the safety data sheet within three months.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "regulatory_update",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(g)(5)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(g)(5)",
      "source_text_excerpt": "Requires updating: if the chemical manufacturer, importer or employer preparing the safety data sheet becomes newly aware of any significant information regarding the hazards of a chemical, or ways to protect against the hazards, this new information shall be added to the safety data sheet within three months.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "5d72c0f49ad7fb806a37b6af80badc98af6e740b5adcb55eaccde6db59b350d1",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-HAZCOM-016",
      "requirement_text": "Employee training shall include methods to detect the presence or release of a hazardous chemical, the physical and health hazards of chemicals in the work area, protective measures, and the details of the employer's hazard communication program.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "interview",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "onboarding_new_employee",
      "workflow_trigger_details": {
        "additional_triggers": [
          "chemical_procurement"
        ],
        "condition": "A new chemical hazard is introduced into the work area."
      },
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_HAZCOM",
      "source_clause": "§1910.1200(h)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(h)(3)",
      "source_text_excerpt": "Employee training shall include at least:\n(i) Methods and observations that may be used to detect the presence or release of a hazardous chemical in the work area (such as monitoring conducted by the employer, continuous monitoring devices, visual appearance or odor of hazardous chemicals when being released, etc.)\n(ii) The physical, health, simple asphyxiation, combustible dust, and pyrophoric gas hazards, as well as hazards not otherwise classified, of the chemicals in the work area\n(iii) The measures employees can take to protect themselves from these hazards, including specific procedures the employer has implemented to protect employees from exposure to hazardous chemicals, such as appropriate work practices, emergency procedures, and personal protective equipment to be used\n(iv) The details of the hazard communication program developed by the employer, including an explanation of the labels received on shipped containers and the workplace labeling system used by their employer; the safety data sheet, including the order of information and how employees can obtain and use the appropriate hazard information",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "c424fe8ceb53b2b70598f95eee10af028542d1cabe5fb0c3e76cdcf9139a9661",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-21",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-001",
      "requirement_text": "The employer shall establish an energy control program consisting of procedures, employee training, and periodic inspections to ensure isolation before servicing or maintenance where unexpected energization, start-up, or release of stored energy could occur and cause injury.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(1)",
      "source_text_excerpt": "The employer shall establish a program consisting of energy control procedures, employee training and periodic inspections to ensure that before any employee performs any servicing or maintenance on a machine or equipment where the unexpected energizing, startup or release of stored energy could occur and cause injury, the machine or equipment shall be isolated from the energy source and rendered inoperative.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "b8830682901a389e56c3bd70b601f4e9b68a3c18f459521ec0c26a799df4bf43",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-002",
      "requirement_text": "Procedures shall be developed, documented, and utilized for the control of potentially hazardous energy when employees are engaged in covered servicing or maintenance activities.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "document_review",
      "audit_evidence_type": "procedure",
      "workflow_trigger": "equipment_change",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(4)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(4)(i)",
      "source_text_excerpt": "Procedures shall be developed, documented and utilized for the control of potentially hazardous energy when employees are engaged in the activities covered by this section.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "a467cb6f8ba32a190103cb624ee5b9e77f61ca1c116044abaa326317f04ead7a",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-003",
      "requirement_text": "The energy control procedures shall clearly and specifically outline the scope, purpose, authorization, rules, and techniques to be utilized for the control of hazardous energy, and the means to enforce compliance.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "procedure",
      "workflow_trigger": "equipment_change",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(4)(ii)",
      "supporting_clauses": [
        "§1910.147(c)(4)(ii)(A)",
        "§1910.147(c)(4)(ii)(B)",
        "§1910.147(c)(4)(ii)(C)",
        "§1910.147(c)(4)(ii)(D)",
        "§1910.147(c)(4)(ii)(E)",
        "§1910.147(c)(4)(ii)(F)"
      ],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(4)(ii)",
      "source_text_excerpt": "The procedures shall clearly and specifically outline the scope, purpose, authorization, rules, and techniques to be utilized for the control of hazardous energy, and the means to enforce compliance.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "1da9cbe125f7fb933c6b257fc21a1e65255d8030e9d8be7138b8b2dcc7f2c9a8",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-004",
      "requirement_text": "The employer shall provide locks, tags, chains, wedges, key blocks, adapter pins, self-locking fasteners, or other hardware for isolating, securing, or blocking machines from energy sources.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(5)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(5)(i)",
      "source_text_excerpt": "Locks, tags, chains, wedges, key blocks, adapter pins, self-locking fasteners, or other hardware shall be provided by the employer for isolating, securing or blocking of machines or equipment from energy sources.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "9077e671cd89e2781bf1a97ed20d2105f6900fa2fd92a6291eb0603961cc9119",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-005",
      "requirement_text": "The employer shall conduct a periodic inspection of the energy control procedure at least annually to ensure that the procedure and the requirements of this standard are being followed.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "inspection_record",
      "workflow_trigger": "annual_review",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(6)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(6)(i)",
      "source_text_excerpt": "The employer shall conduct a periodic inspection of the energy control procedure at least annually to ensure that the procedure and the requirements of this standard are being followed.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "6beaa0d404d1d95f102d5cbc8fd86cfd8a533da77072d1a0c1fe0b0f6cf93504",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-006",
      "requirement_text": "The employer shall provide training to ensure that the purpose and function of the energy control program are understood by employees and that employees acquire the knowledge and skills required for safe application, usage, and removal of energy controls.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "onboarding_new_employee",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(7)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(7)(i)",
      "source_text_excerpt": "The employer shall provide training to ensure that the purpose and function of the energy control program are understood by employees and that the knowledge and skills required for the safe application, usage, and removal of the energy controls are acquired by employees.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "9872e5c16b68275cb1dbf08eebdcce28a2c425d9b915ab924b1efca2b16f625c",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-007",
      "requirement_text": "Retraining shall be provided for all authorized and affected employees whenever there is a change in job assignments, machines, equipment, or processes that present a new hazard, or a change in energy control procedures.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "equipment_change",
      "workflow_trigger_details": {
        "additional_triggers": [
          "job_reassignment",
          "procedure_change"
        ],
        "condition": "Retraining is required after job reassignment, a machine/equipment/process change presenting a new hazard, or a change in energy-control procedures."
      },
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(c)(7)(iii)(A)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(c)(7)(iii)(A)",
      "source_text_excerpt": "Retraining shall be provided for all authorized and affected employees whenever there is a change in their job assignments, a change in machines, equipment or processes that present a new hazard, or when there is a change in the energy control procedures.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "01f71c2dcbafdf480f9cfefb9a8768d3e3df7b7c2b70a1cb3d8bd836bb6f84f8",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-008",
      "requirement_text": "All energy isolating devices needed to control the energy to the machine or equipment shall be physically located and operated in such a manner as to isolate the machine or equipment from energy sources.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "observation",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(d)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(d)(3)",
      "source_text_excerpt": "All energy isolating devices that are needed to control the energy to the machine or equipment shall be physically located and operated in such a manner as to isolate the machine or equipment from the energy source(s).",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "7f42deb76105bf89e305074d1db1b2d20912f640a8a81b61a8e0964930b0aea4",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-009",
      "requirement_text": "Following the application of lockout or tagout devices to energy isolating devices, all potentially hazardous stored or residual energy shall be relieved, disconnected, restrained, and otherwise rendered safe.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "observation",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(d)(5)(i)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(d)(5)(i)",
      "source_text_excerpt": "Following the application of lockout or tagout devices to energy isolating devices, all potentially hazardous stored or residual energy shall be relieved, disconnected, restrained, and otherwise rendered safe.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "75b590786439d79aa418a345ac2331d01971b926ef337b6e7a8634e086b7d96a",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-22",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-LOTO-010",
      "requirement_text": "Each lockout or tagout device shall be removed by the employee who applied it, except that when that employee is unavailable, removal may occur under employer direction using documented specific procedures and training that provide equivalent safety.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "observation",
      "audit_evidence_type": "physical_condition",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {
        "condition": "Removal by another person is permitted only when the applying employee is unavailable and the documented exception procedure is followed."
      },
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        31,
        32
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_LOTO",
      "source_clause": "§1910.147(e)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.147#p-1910.147(e)(3)",
      "source_text_excerpt": "Each lockout or tagout device shall be removed from each energy isolating device by the employee who applied the device.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "879a3c7c50a28e35bf4875b1ab2ce011bda20cf35e4fa93b561ac854059061f8",
      "curation_method": "ai_assisted_with_human_review",
