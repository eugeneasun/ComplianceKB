    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-REC-010",
      "requirement_text": "The employer must keep a separate OSHA 300 Log for each establishment that is expected to be in operation for one year or longer.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "incident_record",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "all_covered_industries",
      "industries_naics": [],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_RECORDKEEPING",
      "source_clause": "§1904.30(a)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1904#p-1904.30(a)",
      "source_text_excerpt": "You must keep a separate OSHA 300 Log for each establishment that is expected to be in operation for one year or longer.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-06-13T00:00:00Z",
      "source_text_hash": "89ae649e50b77b270edd5f8fa1b31c18f5f3f95543dbab1b77de65953ed54c9d",
