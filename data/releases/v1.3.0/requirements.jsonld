      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-013",
      "requirement_text": "The employer shall develop and implement written operating procedures consistent with the process safety information that provide clear instructions for safely conducting activities.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "procedure",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(f)(1)",
      "supporting_clauses": [
        "§1910.119(f)(1)(i)",
        "§1910.119(f)(1)(ii)",
        "§1910.119(f)(1)(iii)",
        "§1910.119(f)(1)(iv)"
      ],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(f)(1)",
      "source_text_excerpt": "The employer shall develop and implement written operating procedures that provide clear instructions for safely conducting activities involved in each covered process consistent with the process safety information.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
