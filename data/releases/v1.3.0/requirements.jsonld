    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-002",
      "requirement_text": "The employer shall consult with employees and their representatives on the conduct and development of process hazard analyses and on other PSM elements.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "interview",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(c)(2)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(c)(2)",
      "source_text_excerpt": "Employers shall consult with employees and their representatives on the conduct and development of process hazards analyses and on the development of the other elements of process safety management.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "70d08dff5c83c0a662d3bb797d8134371f76d1f901f4dfe339ec2f3f4d16390b",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-003",
      "requirement_text": "The employer shall provide employees and their representatives access to process hazard analyses and all other information required under this standard.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(c)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(c)(3)",
      "source_text_excerpt": "Employers shall provide to employees and their representatives access to process hazard analyses and to all other information required to be developed under this standard.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "01ed189eb5675e46d2cbe0c0c7f6a486f6a4d404fa8f7d2dd235168ccd52498e",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-004",
      "requirement_text": "The employer shall complete a compilation of written process safety information on the hazards of the highly hazardous chemicals in the process before conducting any process hazard analysis.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "chemical_handling",
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(d)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(d)",
      "source_text_excerpt": "In accordance with the schedule set forth in paragraph (e)(1) of this section, the employer shall complete a compilation of written process safety information before conducting any process hazard analysis required by the standard. This process safety information shall include information pertaining to the hazards of the highly hazardous chemicals used or produced by the process.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "6536b0965da91ca9f3cf08ae823c7585f2ce8a6817838ffb27c7e86479a1b963",
      "curation_method": "human_reviewed",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-005",
      "requirement_text": "The employer shall document that equipment in the process complies with recognized and generally accepted good engineering practices.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "equipment_change",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance",
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(d)(3)(ii)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(d)(3)(ii)",
      "source_text_excerpt": "The employer shall document that equipment complies with recognized and generally accepted good engineering practices.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "2a9c8e09ef444f31840cac1da5c2f59de1e12c37a5aa33fd00ac4fe1582f59f1",
      "curation_method": "human_reviewed",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-006",
      "requirement_text": "For existing equipment designed and constructed to codes no longer in general use, the employer shall determine and document that the equipment is designed, maintained, inspected, tested, and operating in a safe manner.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "physical_inspection",
      "audit_evidence_type": "inspection_record",
      "workflow_trigger": "equipment_change",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "equipment_maintenance"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(d)(3)(iii)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(d)(3)(iii)",
      "source_text_excerpt": "For existing equipment designed and constructed in accordance with codes, standards, or practices that are no longer in general use, the employer shall determine and document that the equipment is designed, maintained, inspected, tested, and operating in a safe manner.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "0e1c7856cbdd6ff6d354695d4492ebd7c7421f34250ace5c8166f676648055fd",
      "curation_method": "human_reviewed",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-007",
      "requirement_text": "The employer shall perform an initial process hazard analysis on processes covered by this standard.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(e)(1)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(e)(1)",
      "source_text_excerpt": "The employer shall perform an initial process hazard analysis (hazard evaluation) on processes covered by this standard.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "941d88c1fbe0b3647d87d872d8ab70fd4014c5e2661d789b48e0c399c53d417a",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-008",
      "requirement_text": "The process hazard analysis shall address the hazards of the process, identification of previous incidents with catastrophic potential, engineering and administrative controls, consequences of control failure, facility siting, human factors, and a qualitative evaluation of safety and health effects of control failure.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "critical",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(e)(3)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(e)(3)",
      "source_text_excerpt": "The process hazard analysis shall address: (i) The hazards of the process; (ii) The identification of any previous incident which had a likely potential for catastrophic consequences in the workplace; (iii) Engineering and administrative controls applicable to the hazards and their interrelationships such as appropriate application of detection methodologies to provide early warning of releases; (iv) Consequences of failure of engineering and administrative controls; (v) Facility siting; (vi) Human factors; and (vii) A qualitative evaluation of a range of the possible safety and health effects of failure of controls on employees in the workplace.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "2f318106a058b5adaef3b553ae111d5e7fb8cea1f972fe763193f4fa780b5c7e",
      "curation_method": "human_reviewed",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-009",
      "requirement_text": "The process hazard analysis shall be performed by a team with expertise in engineering and process operations, including at least one employee experienced in the process.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "new_process_startup",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(e)(4)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(e)(4)",
      "source_text_excerpt": "The process hazard analysis shall be performed by a team with expertise in engineering and process operations, and the team shall include at least one employee who has experience and knowledge specific to the process being evaluated.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "17c1f99dde2196ec77820d088c512e888f90022f2d4d291176700ac909d423a4",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-010",
      "requirement_text": "The employer shall establish a system to promptly address the process-hazard-analysis team's findings and recommendations, assure timely resolution, document the resolution and actions to be taken, complete actions as soon as possible, maintain a written completion schedule, and communicate the actions to affected personnel.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(e)(5)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(e)(5)",
      "source_text_excerpt": "The employer shall establish a system to promptly address the team's findings and recommendations; assure that the recommendations are resolved in a timely manner and that the resolution is documented; document what actions are to be taken; complete actions as soon as possible; develop a written schedule of when these actions are to be completed; communicate the actions to operating, maintenance and other employees whose work assignments are in the process and who may be affected by the recommendations or actions.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "dd12192218660279e45fa964c17c742bb616c577ee00b58913f9d2be1db641e0",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-011",
      "requirement_text": "At least every five years after the initial process hazard analysis, the employer shall update and revalidate the analysis.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "document_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "periodic_review",
      "workflow_trigger_details": {
        "interval_years": 5
      },
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(e)(6)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(e)(6)",
      "source_text_excerpt": "At least every five (5) years after the completion of the initial process hazard analysis, the process hazard analysis shall be updated and revalidated by a team meeting the requirements in paragraph (e)(4) of this section.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-05-04T00:00:00Z",
      "source_text_hash": "48d5851c4f2669e122962e64c7ae46ddf6da6d7e46a42a5bccdb002f0c698733",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
      "review_date": "2026-09-24",
      "verification_status": "implemented_from_human_verification"
    },
    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-012",
      "requirement_text": "The employer shall retain process hazard analyses, updates, revalidations, and resolutions of recommendations for the life of the process.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "medium",
      "verification_method": "record_review",
      "audit_evidence_type": "written_program",
      "workflow_trigger": "always_on",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
      "business_activities": [
        "process_operation"
      ],
      "employee_size_band": "any",
      "jurisdictions": [
        "federal"
      ],
      "source_framework": "OSHA_PSM",
      "source_clause": "§1910.119(e)(7)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.119#p-1910.119(e)(7)",
      "source_text_excerpt": "Employers shall retain process hazards analyses and updates or revalidations for each process covered by this section, as well as the documented resolution of recommendations described in paragraph (e)(5) of this section for the life of the process.",
      "source_version": "2024-07-01",
      "source_retrieved_at": "2026-09-26T00:00:00Z",
      "source_text_hash": "8b7e3f9021108baf6eb37ffa4825e3e3d00c01e458ff22af28da0a3f036af0e8",
      "curation_method": "ai_assisted_with_human_review",
      "curator": "Eugene Sun",
