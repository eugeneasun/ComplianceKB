      "source_clause": "§1910.1200(f)(9)",
      "supporting_clauses": [],
      "source_url": "https://www.ecfr.gov/current/title-29/part-1910/section-1910.1200#p-1910.1200(f)(9)",
      "source_text_excerpt": "The employer shall not remove or deface existing labels on incoming containers of hazardous chemicals, unless the container is immediately marked with the required information.",
