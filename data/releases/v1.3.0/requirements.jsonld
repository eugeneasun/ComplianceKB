    {
      "@type": "trus:ComplianceRequirement",
      "id": "trus:OSHA-PSM-020",
      "requirement_text": "The contract employer shall assure that each contract employee is trained in the work practices necessary to safely perform their job.",
      "is_mandatory": true,
      "requirement_type": "obligation",
      "risk_level": "high",
      "verification_method": "record_review",
      "audit_evidence_type": "training_record",
      "workflow_trigger": "onboarding_new_employee",
      "workflow_trigger_details": {},
      "industry_scope": "listed_naics_only",
      "industries_naics": [
        32,
        31
      ],
      "industry_condition": "",
